# ─────────────────────────────────────────────────────────────────────────────
# Candler environment variables
# Copy to `.env.local` (git-ignored) and fill in real values from your Supabase
# project settings → API. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public — safe to expose to the client -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute URL of this deployment. Used for auth email redirect links, the
# OAuth/callback origin, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Server-only — NEVER prefix with NEXT_PUBLIC, never import into client code -----
# Secret key (sb_secret_...). Grants elevated, RLS-bypassing access.
# Used only by the server admin client (invites, audit writes, Cloud mutations).
SUPABASE_SECRET_KEY=

# Server-only Stripe (test mode until launch). Never prefix with NEXT_PUBLIC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CANDLER_PRO=
STRIPE_PRICE_CLOUD_500=
STRIPE_PRICE_CLOUD_1TB=
